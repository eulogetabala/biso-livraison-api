APP_NAME=
NODE_ENV=
PORT=3001

# Base de données
#   - DATABASE_URL        : utilisée en production (Neon en prod)
#   - DATABASE_URL_LOCAL  : utilisée automatiquement hors production (Docker)
#     → sélection dans src/config/database-url.ts (NODE_ENV !== 'production')
DATABASE_URL=
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/delivery_db?schema=public
DB_POOL_MAX=10
# Timeout de connexion (ms). Élevé par défaut : Neon/Postgres serverless mettent
# la base en veille et le réveil peut prendre plusieurs secondes.
DB_CONNECT_TIMEOUT_MS=15000

JWT_SECRET=
JWT_REFRESH_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@biso-livraison.app

REDIS_URL=redis://localhost:6379

THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_TTL_MS=60000

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

UPLOAD_DIR=public/uploads
PUBLIC_UPLOAD_URL=/uploads

# Cloudinary (prod Render — persistance images). Si les 3 vars sont définies, upload Cloudinary ; sinon disque local.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=biso-livraison

# Render (exemple après deploy)
# DATABASE_URL=          # base externe Neon (gratuit, sans expiration) :
#   postgresql://<user>:<pwd>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#   (la base Render gratuite expire au bout de ~30 jours → préférer Neon)
#   Pour viser la base depuis la machine locale : lancer avec
#   NODE_ENV=production (la sélection ignore alors DATABASE_URL_LOCAL), et
#   garder sslmode=require. Le code normalise sslmode → options `ssl` explicites
#   (plus d'avertissement pg). Pour la sémantique libpq (chiffrement sans vérif.
#   du certificat), ajouter uselibpqcompat=true à la query string.
# REDIS_URL=             # injecté par Render Key Value
# UPLOAD_DIR=/var/data/uploads
# CORS_ORIGINS=https://biso-dashboard.onrender.com
# NODE_ENV=production
# ALLOW_TEST_OTP=false
