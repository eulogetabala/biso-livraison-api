generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  CLIENT
  DRIVER
  ADMIN
  PARTNER
}

enum MenuItemCategory {
  APPETIZER
  MAIN_COURSE
  DESSERT
  DRINK
  FRUIT
  LUNCH
  SNACK
  SIDE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
}

enum ParcelStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum NotificationType {
  ORDER_STATUS
  DELIVERY_STATUS
  PAYMENT
  PROMOTIONAL
}

enum FavoriteKind {
  RESTAURANT
  PRODUCT
}

enum RestaurantType {
  RESTAURANT
  MARKET
}

enum MenuItemKind {
  RESTAURANT_DISH
  SIMPLE_PRODUCT
}

enum BannerLinkType {
  RESTAURANTS
  PRODUCTS
  PARCEL
  URL
  NONE
}


model User {
  id        String   @id @default(uuid())

  email     String?

  password  String

  firstName String
  lastName  String

  phone     String   @unique

  phoneVerified Boolean @default(false)

  isBlocked Boolean @default(false)

  avatarUrl String?

  role      UserRole @default(CLIENT)

  orders         Order[]
  deliveries     Delivery[]
  driverProfile  DriverProfile?
  parcels        Parcel[]
  notifications  Notification[]
  driverLocation DriverLocation?
  reviews        Review[]    @relation("ReviewAuthor")
  driverReviews  Review[]    @relation("ReviewDriver")
  favorites      Favorite[]

  expoPushToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DriverProfile {
  id           String  @id @default(uuid())

  userId       String  @unique

  vehicleType  String  @default("MOTO")
  vehiclePlate String?

  isAvailable  Boolean @default(false)

  rating      Float @default(0)
  reviewCount Int   @default(0)

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isAvailable])
}

model Restaurant {
  id          String   @id @default(uuid())

  name        String
  description String?
  address     String
  city        String
  zipCode     String
  phone       String
  cuisineType String

  imageUrl     String?
  coverImageUrl String?

  isActive    Boolean  @default(true)
  rating      Float    @default(0)

  type        RestaurantType @default(RESTAURANT)
  isFeatured  Boolean @default(false)
  sortOrder   Int     @default(0)

  deliveryFee            Float @default(0)
  estimatedDeliveryTime  Int   @default(30)

  latitude   Float?
  longitude  Float?

  menuItems   MenuItem[]
  orders      Order[]
  reviews     Review[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id           String   @id @default(uuid())

  restaurantId String?
  kind         MenuItemKind @default(RESTAURANT_DISH)

  name         String
  description  String?
  price        Float
  category     MenuItemCategory

  imageUrl    String?

  isAvailable  Boolean  @default(true)

  seller           String?
  badge            String?
  isFeatured       Boolean @default(false)
  sortOrder        Int     @default(0)

  marketCategoryId String?
  marketCategory   MarketCategory? @relation(fields: [marketCategoryId], references: [id], onDelete: SetNull)

  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplements  MenuItemSupplement[]
  orderItems   OrderItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId])
  @@index([marketCategoryId])
  @@index([kind])
}

model MenuItemSupplement {
  id          String   @id @default(uuid())

  menuItemId  String
  name        String
  price       Float
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)

  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([menuItemId])
}

model MarketCategory {
  id        String   @id @default(uuid())

  label     String
  subtitle  String?
  imageUrl  String?
  icon      String   @default("basket-outline")
  iconLib   String   @default("ionicons")
  tint      String   @default("#EDE9FE")
  iconColor String   @default("#7C3AED")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeBanner {
  id        String   @id @default(uuid())

  title     String
  subtitle  String?
  imageUrl  String
  ctaLabel  String?
  linkType  BannerLinkType @default(NONE)
  linkValue String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CuisineTypeConfig {
  id        String   @id @default(uuid())

  value     String   @unique
  label     String
  emoji     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id           String      @id @default(uuid())

  userId       String
  restaurantId String

  status       OrderStatus @default(PENDING)
  total        Float       @default(0)

  deliveryAddress  String @default("")
  deliveryCity     String @default("")
  deliveryZipCode  String @default("")

  deliveryLatitude   Float?
  deliveryLongitude  Float?

  deliveryFee   Float       @default(0)
  grandTotal    Float       @default(0)

  items        OrderItem[]
  review       Review?

  delivery     Delivery?
  payment      Payment?

  user         User        @relation(fields: [userId], references: [id])
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([restaurantId])
  @@index([status])
}

model OrderItem {
  id         String   @id @default(uuid())

  orderId    String
  menuItemId String

  quantity   Int
  unitPrice  Float

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

model Review {
  id           String  @id @default(uuid())

  orderId      String  @unique
  userId       String
  restaurantId String?
  driverId     String?

  rating       Int
  comment      String?

  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author       User      @relation("ReviewAuthor", fields: [userId], references: [id])
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  driver       User?     @relation("ReviewDriver", fields: [driverId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([restaurantId])
  @@index([driverId])
  @@index([userId])
}

model Delivery {
  id          String         @id @default(uuid())

  orderId     String?        @unique
  parcelId    String?        @unique
  driverId    String

  status      DeliveryStatus @default(ASSIGNED)

  pickedUpAt  DateTime?
  deliveredAt DateTime?

  trackingEvents TrackingEvent[]

  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parcel      Parcel?        @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  driver      User           @relation(fields: [driverId], references: [id])

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([driverId])
  @@index([status])
}

model TrackingEvent {
  id         String       @id @default(uuid())

  deliveryId String

  status     DeliveryStatus
  message    String?
  latitude   Float?
  longitude  Float?

  delivery   Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  createdAt  DateTime     @default(now())

  @@index([deliveryId])
  @@index([createdAt])
}

model Parcel {
  id             String       @id @default(uuid())

  senderId       String

  receiverName   String
  receiverPhone  String
  receiverAddress String

  description    String?
  weight         Float        @default(0)

  status         ParcelStatus @default(PENDING)

  deliveredAt    DateTime?

  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  delivery       Delivery?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([senderId])
  @@index([status])
}

model Payment {
  id        String        @id @default(uuid())

  orderId   String        @unique

  method    PaymentMethod @default(CASH_ON_DELIVERY)
  status    PaymentStatus @default(PENDING)

  amount    Float

  paidAt    DateTime?

  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())

  userId    String

  type      NotificationType

  title     String
  message   String

  readAt    DateTime?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
}

model DriverLocation {
  id        String   @id @default(uuid())

  driverId  String   @unique

  latitude  Float
  longitude Float

  deliveryId String?

  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model Favorite {
  id        String       @id @default(uuid())

  userId    String
  targetId  String
  kind      FavoriteKind

  name        String
  imageUrl    String?
  price       Float?
  seller      String?
  cuisineType String?
  rating      Float?
  city        String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, targetId, kind])
  @@index([userId])
}