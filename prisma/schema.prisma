generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  CLIENT
  DRIVER
  ADMIN
  PARTNER
}

enum MenuItemCategory {
  APPETIZER
  MAIN_COURSE
  DESSERT
  DRINK
  FRUIT
  LUNCH
  SNACK
  SIDE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
}

enum ParcelStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum NotificationType {
  ORDER_STATUS
  DELIVERY_STATUS
  PAYMENT
  PROMOTIONAL
}


model User {
  id        String   @id @default(uuid())

  email     String   @unique
  password  String

  firstName String
  lastName  String

  phone     String

  avatarUrl String?

  role      UserRole @default(CLIENT)

  orders         Order[]
  deliveries     Delivery[]
  driverProfile  DriverProfile?
  parcels        Parcel[]
  notifications  Notification[]
  driverLocation DriverLocation?
  reviews        Review[]    @relation("ReviewAuthor")
  driverReviews  Review[]    @relation("ReviewDriver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DriverProfile {
  id           String  @id @default(uuid())

  userId       String  @unique

  vehicleType  String  @default("MOTO")
  vehiclePlate String?

  isAvailable  Boolean @default(false)

  rating      Float @default(0)
  reviewCount Int   @default(0)

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isAvailable])
}

model Restaurant {
  id          String   @id @default(uuid())

  name        String
  description String?
  address     String
  city        String
  zipCode     String
  phone       String
  cuisineType String

  imageUrl     String?
  coverImageUrl String?

  isActive    Boolean  @default(true)
  rating      Float    @default(0)

  deliveryFee            Float @default(0)
  estimatedDeliveryTime  Int   @default(30)

  menuItems   MenuItem[]
  orders      Order[]
  reviews     Review[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id           String   @id @default(uuid())

  restaurantId String

  name         String
  description  String?
  price        Float
  category     MenuItemCategory

  imageUrl    String?

  isAvailable  Boolean  @default(true)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId])
}

model Order {
  id           String      @id @default(uuid())

  userId       String
  restaurantId String

  status       OrderStatus @default(PENDING)
  total        Float       @default(0)

  deliveryAddress  String @default("")
  deliveryCity     String @default("")
  deliveryZipCode  String @default("")

  deliveryFee   Float       @default(0)
  grandTotal    Float       @default(0)

  items        OrderItem[]
  review       Review?

  delivery     Delivery?
  payment      Payment?

  user         User        @relation(fields: [userId], references: [id])
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([restaurantId])
  @@index([status])
}

model OrderItem {
  id         String   @id @default(uuid())

  orderId    String
  menuItemId String

  quantity   Int
  unitPrice  Float

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

model Review {
  id           String  @id @default(uuid())

  orderId      String  @unique
  userId       String
  restaurantId String?
  driverId     String?

  rating       Int
  comment      String?

  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author       User      @relation("ReviewAuthor", fields: [userId], references: [id])
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  driver       User?     @relation("ReviewDriver", fields: [driverId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([restaurantId])
  @@index([driverId])
  @@index([userId])
}

model Delivery {
  id          String         @id @default(uuid())

  orderId     String         @unique
  driverId    String

  status      DeliveryStatus @default(ASSIGNED)

  pickedUpAt  DateTime?
  deliveredAt DateTime?

  trackingEvents TrackingEvent[]

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver      User           @relation(fields: [driverId], references: [id])

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([driverId])
  @@index([status])
}

model TrackingEvent {
  id         String       @id @default(uuid())

  deliveryId String

  status     DeliveryStatus
  message    String?
  latitude   Float?
  longitude  Float?

  delivery   Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  createdAt  DateTime     @default(now())

  @@index([deliveryId])
  @@index([createdAt])
}

model Parcel {
  id             String       @id @default(uuid())

  senderId       String

  receiverName   String
  receiverPhone  String
  receiverAddress String

  description    String?
  weight         Float        @default(0)

  status         ParcelStatus @default(PENDING)

  deliveredAt    DateTime?

  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([senderId])
  @@index([status])
}

model Payment {
  id        String        @id @default(uuid())

  orderId   String        @unique

  method    PaymentMethod @default(CASH_ON_DELIVERY)
  status    PaymentStatus @default(PENDING)

  amount    Float

  paidAt    DateTime?

  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())

  userId    String

  type      NotificationType

  title     String
  message   String

  readAt    DateTime?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
}

model DriverLocation {
  id        String   @id @default(uuid())

  driverId  String   @unique

  latitude  Float
  longitude Float

  deliveryId String?

  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}